APP_NAME=PyFlow App
APP_VERSION=v3.0.9
APP_DEBUG=true
APP_URL=http://localhost:8000
SECRET_KEY=change-this-to-a-random-64-char-hex-string

# Database configuration for Docker (MySQL)
DB_DRIVER=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=pyflow_db
DB_USER=root
DB_PASSWORD=rootpassword
DB_POOL_SIZE=5
DB_TIMEZONE=+06:00

# Directory paths inside the container
SESSION_DIR=storage/sessions
SESSION_SECURE_COOKIE=false
VIEWS_DIR=app/views
LOG_FILE=storage/logs/app.log

# Google Gemini API Key
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Rate Limiting Settings
LOGIN_LIMIT_ATTEMPTS=5
LOGIN_LIMIT_SECONDS=300
REGISTER_LIMIT_ATTEMPTS=3
REGISTER_LIMIT_SECONDS=300

# DDoS Alert settings
DDOS_THRESHOLD_RPM=1000

