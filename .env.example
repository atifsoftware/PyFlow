APP_NAME=PyFlow App
APP_VERSION=v3.0.9
APP_DEBUG=true
APP_URL=http://localhost:8000

# random.token_hex(32) দিয়ে জেনারেট করুন - core/security.py-এর generate_secret_key()
SECRET_KEY=change-this-to-a-random-64-char-hex-string

# ─────────────────────────────────────────────────────────────────
# Database Driver — একটি বেছে নিন:
#   sqlite      → development/testing (কোনো setup লাগে না)
#   mysql       → production (shared hosting, cPanel)
#   postgresql  → production (VPS, AWS RDS, Supabase, Neon)
# ─────────────────────────────────────────────────────────────────
DB_DRIVER=sqlite

# ─── SQLite (development) ────────────────────────────────────────
DB_NAME=storage/database.sqlite

# ─── MySQL (production) ──────────────────────────────────────────
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=pyflow_db
# DB_USER=root
# DB_PASSWORD=yourpassword
# DB_POOL_SIZE=5
# DB_TIMEZONE=+06:00

# ─── PostgreSQL (production / ERP / Accounting) ──────────────────
# DB_DRIVER=postgresql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=pyflow_db
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_SCHEMA=public
# DB_POOL_SIZE=5

SESSION_DIR=storage/sessions
SESSION_SECURE_COOKIE=false

VIEWS_DIR=app/views
LOG_FILE=storage/logs/app.log

# ─── Cache Driver ────────────────────────────────────────────────
# CACHE_DRIVER=file     (default)
# CACHE_DRIVER=memory
# CACHE_DRIVER=redis

# ─── Rate Limiting (ব্রুট-ফোর্স ও হ্যাকার প্রোটেকশন) ────────────────
# লগইন লিমিট (ডিফল্ট: ৫ মিনিটে সর্বোচ্চ ৫ বার চেষ্টা)
LOGIN_LIMIT_ATTEMPTS=5
LOGIN_LIMIT_SECONDS=300

# রেজিস্ট্রেশন লিমিট (ডিফল্ট: ৫ মিনিটে সর্বোচ্চ ৩ বার চেষ্টা)
REGISTER_LIMIT_ATTEMPTS=3
REGISTER_LIMIT_SECONDS=300

# ─── Traffic Monitor & DDoS Shield (অস্বাভাবিক ট্রাফিক অ্যালার্ট) ────
# মিনিটে সর্বোচ্চ কতটি রিকোয়েস্ট হলে সিকিউরিটি অ্যালার্ট ট্রিগার করবে
DDOS_THRESHOLD_RPM=1000


